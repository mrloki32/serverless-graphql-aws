# Non-secret sizing/feature flags for the staging stage (sourced by infra/scripts/common.sh).
# Cost-optimised: single NAT gateway, Fargate Spot, smallest Graviton DB, no proxy/replica.
HA_NAT=false

DB_INSTANCE_CLASS=db.t4g.micro
DB_MULTI_AZ=false
DB_READ_REPLICA=false
DB_PROXY=false
DB_DELETION_PROTECTION=false
DB_BACKUP_RETENTION_DAYS=7
DB_PERFORMANCE_INSIGHTS=false
DB_CONNECTIONS_ALARM=60

ECS_MIN_TASKS=1
ECS_MAX_TASKS=3
ECS_TASK_CPU=256
ECS_TASK_MEMORY=512
ECS_USE_SPOT=true

LOG_RETENTION_DAYS=30
