# Non-secret sizing/feature flags for the prod stage (sourced by infra/scripts/common.sh).
# Highly available: NAT per AZ, Multi-AZ RDS + read replica + RDS Proxy, on-demand Fargate.
HA_NAT=true

DB_INSTANCE_CLASS=db.t4g.medium
DB_MULTI_AZ=true
DB_READ_REPLICA=true
DB_PROXY=true
DB_DELETION_PROTECTION=true
DB_BACKUP_RETENTION_DAYS=14
DB_PERFORMANCE_INSIGHTS=true
DB_CONNECTIONS_ALARM=300

ECS_MIN_TASKS=2
ECS_MAX_TASKS=10
ECS_TASK_CPU=512
ECS_TASK_MEMORY=1024
ECS_USE_SPOT=false

LOG_RETENTION_DAYS=90
