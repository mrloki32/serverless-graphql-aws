{
  "name": "gqlapp",
  "private": true,
  "description": "Serverless GraphQL architecture on AWS: React + AppSync/Lambda + private Apollo on ECS Fargate + RDS PostgreSQL",
  "workspaces": [
    "packages/*",
    "services/*",
    "frontend"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "npm run test --workspaces --if-present",
    "db:up": "docker compose up -d postgres",
    "db:migrate": "tsx scripts/migrate-local.ts",
    "dev:server": "npm run dev -w @gqlapp/graphql-server",
    "dev:frontend": "npm run dev -w @gqlapp/frontend",
    "smoke": "node scripts/smoke-test.mjs",
    "validate:api": "node scripts/validate-serverless.mjs"
  },
  "devDependencies": {
    "@aws-crypto/sha256-js": "^5.2.0",
    "@aws-sdk/credential-provider-node": "^3.700.0",
    "@eslint/js": "^9.15.0",
    "@smithy/protocol-http": "^4.1.7",
    "@smithy/signature-v4": "^4.2.3",
    "@types/node": "^22.10.0",
    "eslint": "^9.15.0",
    "globals": "^15.12.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.16.0",
    "vitest": "^3.2.4"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.24.2": true,
    "@apollo/protobufjs@1.2.8": true
  }
}
